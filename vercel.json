{
  "headers": [
    {
      "source": "/(favicon\\.ico|site\\.webmanifest|355-capital-.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apple-touch-icon.png",
      "destination": "/355-capital-apple.png",
      "permanent": false
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/355-capital-apple.png",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/)(?!.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
